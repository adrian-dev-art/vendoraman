DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
PLANNER_UNLOCK_FEE=150000
# Public canonical URL (no trailing slash). Used for sitemap + social preview tags.
SITE_URL=http://127.0.0.1:8000
# Optional analytics ID (empty = no tracking). Only loads after cookie consent.
ANALYTICS_ID=
# E-mail keluar (OTP). Dev: kosongkan = cetak ke terminal. Produksi: isi SMTP.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=noreply@vendoraman.id
# EMAIL_HOST_PASSWORD=isi-app-password
# Production HTTPS hardening (set all three behind TLS):
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# Link toko/voucher Shopee untuk promo langganan (ganti dengan URL toko Anda).
SHOPEE_VOUCHER_URL=https://shopee.co.id/toko-anda

